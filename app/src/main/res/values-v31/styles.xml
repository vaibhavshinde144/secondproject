<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/color_primary_dark</item>
        <item name="android:navigationBarColor">@color/navigation_color</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_safe</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/background_color</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
    </style>
</resources>
